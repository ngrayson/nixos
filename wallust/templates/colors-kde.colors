# wallust → KDE/Plasma color scheme (Dolphin, Kate, System Settings, etc.)
# Maps generated palette to Breeze-like roles. Requires `| rgb` (comma-separated R,G,B).

[ColorEffects:Disabled]
Color={{ color8 | rgb }}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{ color8 | rgb }}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{ color0 | rgb }}
BackgroundNormal={{ color0 | rgb }}
DecorationFocus={{ color4 | rgb }}
DecorationHover={{ color4 | rgb }}
ForegroundActive={{ color4 | rgb }}
ForegroundInactive={{ color8 | rgb }}
ForegroundLink={{ color12 | rgb }}
ForegroundNegative={{ color1 | rgb }}
ForegroundNeutral={{ color3 | rgb }}
ForegroundNormal={{ foreground | rgb }}
ForegroundPositive={{ color2 | rgb }}
ForegroundVisited={{ color5 | rgb }}

[Colors:Complementary]
BackgroundAlternate={{ color0 | rgb }}
BackgroundNormal={{ background | rgb }}
DecorationFocus={{ color4 | rgb }}
DecorationHover={{ color4 | rgb }}
ForegroundActive={{ color4 | rgb }}
ForegroundInactive={{ color8 | rgb }}
ForegroundLink={{ color12 | rgb }}
ForegroundNegative={{ color1 | rgb }}
ForegroundNeutral={{ color3 | rgb }}
ForegroundNormal={{ foreground | rgb }}
ForegroundPositive={{ color2 | rgb }}
ForegroundVisited={{ color5 | rgb }}

