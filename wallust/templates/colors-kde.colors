[General]
ColorScheme=wallust
Name=Wallust
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{ color0 | rgb }}
activeBlend={{ foreground | rgb }}
activeForeground={{ foreground | rgb }}
inactiveBackground={{ background | rgb }}
inactiveBlend={{ color8 | rgb }}
inactiveForeground={{ color8 | rgb }}
