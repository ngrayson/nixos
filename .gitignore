# nix-build / nixos-rebuild convenience symlink in cwd
result
result-*

# sops-nix / age private material — Bitwarden only, never git
keys.txt
*.agekey
age-key.txt
secrets/*.plain.yaml
secrets/*.plaintext.yaml

# Hearth intranet: local widget settings (build reads these; not the examples)
/hosts/Hearth/intranet/config/*/config.nix

# Python bytecode caches (e.g. home/programs/hearth-tui/)
__pycache__/
*.pyc

